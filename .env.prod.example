# EnglishOS — variables de PRODUCCIÓN. Copia a ".env" en el servidor y completa. NUNCA subas el .env al repositorio.
# Genera contraseñas largas y aleatorias, p. ej.:  openssl rand -base64 32

# --- Dominio y HTTPS (Caddy obtiene el certificado de Let's Encrypt)
DOMAIN=englishos.example.mx
ACME_EMAIL=operaciones@example.mx
# acme en producción (Let's Encrypt). "internal" solo para pruebas locales (CA interna de Caddy).
TLS_MODE=acme

# --- Base de datos
DB_USER=englishos
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Correo (SMTP con STARTTLS)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=EnglishOS <no-reply@example.mx>

# --- Primer administrador (solo se usa si aún no existe ninguno; después puedes vaciarlo)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_MONTHLY_CAP_MXN=1000.00

# --- IA (fake = simulada; openai = real, requiere OPENAI_API_KEY y tarifas registradas en Finanzas)
AI_PROVIDER=fake
AI_TEXT_MODEL=fake-tutor-1
AI_VOICE_PROVIDER=fake
AI_REALTIME_MODEL=fake-voice-1
AI_REALTIME_TRANSCRIPTION_MODEL=gpt-live-transcribe
OPENAI_API_KEY=

# --- Pagos (none = sin pasarela; mercadopago = Checkout Pro). Empieza con credenciales de PRUEBA.
PAYMENTS_PROVIDER=none
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_TEST_MODE=true

# --- Versiones de los documentos legales aceptados al registrarse (cámbialas al publicar la versión revisada)
LEGAL_TERMS_VERSION=2026-11-draft
LEGAL_PRIVACY_VERSION=2026-11-draft

# --- Respaldos (infra/backup/backup.sh)
BACKUP_DIR=/opt/englishos/backups
BACKUP_KEEP_DAYS=14
# Clave pública de `age` para cifrar los respaldos antes de copiarlos fuera del servidor.
AGE_RECIPIENT=
