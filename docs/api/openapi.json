{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "EnglishOS API",
    "description" : "API de EnglishOS. Autenticación por cookie de sesión + cabecera X-XSRF-TOKEN.",
    "version" : "v1"
  },
  "paths" : {
    "/api/v1/admin/users/{publicId}/roles" : {
      "put" : {
        "tags" : [ "admin-user-controller" ],
        "operationId" : "changeRoles",
        "parameters" : [ {
          "name" : "publicId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ChangeRolesRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AdminUserView"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/verify-email" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "operationId" : "verifyEmail",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/TokenRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "object",
                  "additionalProperties" : {
                    "type" : "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/resend-verification" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "operationId" : "resendVerification",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/EmailRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Accepted"
          }
        }
      }
    },
    "/api/v1/auth/register" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "operationId" : "register",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Created",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RegisterResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/password-reset/request" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "operationId" : "requestPasswordReset",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/EmailRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Accepted"
          }
        }
      }
    },
    "/api/v1/auth/password-reset/confirm" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "operationId" : "confirmPasswordReset",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PasswordResetConfirmRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      }
    },
    "/api/v1/auth/login" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeView"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/users/{publicId}/suspend" : {
      "post" : {
        "tags" : [ "admin-user-controller" ],
        "operationId" : "suspend",
        "parameters" : [ {
          "name" : "publicId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AdminUserView"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/users/{publicId}/reactivate" : {
      "post" : {
        "tags" : [ "admin-user-controller" ],
        "operationId" : "reactivate",
        "parameters" : [ {
          "name" : "publicId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AdminUserView"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/profile" : {
      "patch" : {
        "tags" : [ "me-controller" ],
        "operationId" : "updateProfile",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateProfileRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProfileView"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me" : {
      "get" : {
        "tags" : [ "me-controller" ],
        "operationId" : "me",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeView"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/csrf" : {
      "get" : {
        "tags" : [ "auth-controller" ],
        "operationId" : "csrf",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CsrfResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/users" : {
      "get" : {
        "tags" : [ "admin-user-controller" ],
        "operationId" : "search",
        "parameters" : [ {
          "name" : "q",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "status",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "ACTIVE", "SUSPENDED", "DELETED" ]
          }
        }, {
          "name" : "page",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0
          }
        }, {
          "name" : "size",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseAdminUserView"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "ChangeRolesRequest" : {
        "type" : "object",
        "properties" : {
          "roles" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "enum" : [ "ADMIN", "STUDENT" ]
            },
            "minItems" : 1,
            "uniqueItems" : true
          }
        },
        "required" : [ "roles" ]
      },
      "AdminUserView" : {
        "type" : "object",
        "properties" : {
          "publicId" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "displayName" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string"
          },
          "emailVerified" : {
            "type" : "boolean"
          },
          "roles" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            },
            "uniqueItems" : true
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "lastLoginAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "TokenRequest" : {
        "type" : "object",
        "properties" : {
          "token" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 0
          }
        },
        "required" : [ "token" ]
      },
      "EmailRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          }
        },
        "required" : [ "email" ]
      },
      "RegisterRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 12
          },
          "displayName" : {
            "type" : "string",
            "maxLength" : 80,
            "minLength" : 1
          },
          "acceptTerms" : {
            "type" : "boolean"
          },
          "acceptPrivacy" : {
            "type" : "boolean"
          }
        },
        "required" : [ "displayName", "email", "password" ]
      },
      "RegisterResponse" : {
        "type" : "object",
        "properties" : {
          "publicId" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "emailVerificationRequired" : {
            "type" : "boolean"
          }
        }
      },
      "PasswordResetConfirmRequest" : {
        "type" : "object",
        "properties" : {
          "token" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 0
          },
          "newPassword" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 12
          }
        },
        "required" : [ "newPassword", "token" ]
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "maxLength" : 254,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 0
          }
        },
        "required" : [ "email", "password" ]
      },
      "MeView" : {
        "type" : "object",
        "properties" : {
          "publicId" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "emailVerified" : {
            "type" : "boolean"
          },
          "roles" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            },
            "uniqueItems" : true
          },
          "permissions" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            },
            "uniqueItems" : true
          },
          "profile" : {
            "$ref" : "#/components/schemas/ProfileView"
          }
        }
      },
      "ProfileView" : {
        "type" : "object",
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "explanationLanguage" : {
            "type" : "string"
          },
          "timezone" : {
            "type" : "string"
          },
          "dailyGoalMinutes" : {
            "type" : "integer",
            "format" : "int32"
          },
          "storeTranscripts" : {
            "type" : "boolean"
          },
          "onboardingCompleted" : {
            "type" : "boolean"
          }
        }
      },
      "UpdateProfileRequest" : {
        "type" : "object",
        "properties" : {
          "displayName" : {
            "type" : "string",
            "maxLength" : 80,
            "minLength" : 1
          },
          "explanationLanguage" : {
            "type" : "string",
            "pattern" : "es|en"
          },
          "timezone" : {
            "type" : "string",
            "maxLength" : 64,
            "minLength" : 0
          },
          "dailyGoalMinutes" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 240,
            "minimum" : 5
          },
          "storeTranscripts" : {
            "type" : "boolean"
          }
        }
      },
      "CsrfResponse" : {
        "type" : "object",
        "properties" : {
          "headerName" : {
            "type" : "string"
          },
          "token" : {
            "type" : "string"
          }
        }
      },
      "PageResponseAdminUserView" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/AdminUserView"
            }
          },
          "page" : {
            "type" : "integer",
            "format" : "int32"
          },
          "size" : {
            "type" : "integer",
            "format" : "int32"
          },
          "totalItems" : {
            "type" : "integer",
            "format" : "int64"
          },
          "totalPages" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      }
    }
  }
}
