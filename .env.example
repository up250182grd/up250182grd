# EnglishOS — variables de entorno. Copia a `.env` (no se versiona) y ajusta valores.
# NUNCA pongas claves reales en este archivo de ejemplo.

# --- Perfil de Spring: dev | test | prod
SPRING_PROFILES_ACTIVE=dev

# --- Base de datos MySQL 8.4
DB_URL=jdbc:mysql://localhost:3306/englishos
DB_USER=englishos
DB_PASSWORD=englishos-dev
MYSQL_ROOT_PASSWORD=root-dev-only

# --- URL pública del frontend (se usa en los enlaces de los correos)
APP_BASE_URL=http://localhost:5173
# Orígenes CORS permitidos (vacío en producción: frontend y API en el mismo origen)
CORS_ALLOWED_ORIGINS=
# En producción debe ser true (HTTPS). El perfil dev lo desactiva para http://localhost.
SESSION_COOKIE_SECURE=true

# --- Primer administrador (solo se usa si no existe ningún ADMIN; bórralo después del primer arranque)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_DISPLAY_NAME=Administrador

# --- Correo transaccional (Mailpit en desarrollo)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM="EnglishOS <no-reply@englishos.local>"

# --- Versiones vigentes de los documentos legales que acepta el usuario al registrarse
LEGAL_TERMS_VERSION=2026-11-draft
LEGAL_PRIVACY_VERSION=2026-11-draft

# --- OpenAPI/Swagger (solo desarrollo)
OPENAPI_ENABLED=false

# --- Profesor IA (Fase 4)
# fake = profesor simulado (sin red, sin costo real). openai = proveedor real.
AI_PROVIDER=fake
# Código del modelo; debe estar registrado con tarifa vigente en Administración → Finanzas.
AI_TEXT_MODEL=fake-tutor-1
# Clave del proveedor: SOLO en el servidor. Nunca la subas al repositorio.
OPENAI_API_KEY=

# --- Pagos (Fase 7). none = sin pasarela; mercadopago = Checkout Pro.
PAYMENTS_PROVIDER=none
# Credenciales de PRUEBA de Mercado Pago: SOLO en el servidor. Nunca las subas al repositorio.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_TEST_MODE=true
# URL pública HTTPS del webhook (…/api/v1/webhooks/mercadopago).
PAYMENTS_NOTIFICATION_URL=

# --- Voz en tiempo real (Fase 5)
# fake = llamada simulada (sin audio, sin costo real). openai = WebRTC real con OpenAI Realtime.
AI_VOICE_PROVIDER=fake
# Debe estar registrado (modalidad REALTIME) con tarifa vigente en Administración → Finanzas.
AI_REALTIME_MODEL=fake-voice-1
AI_REALTIME_VOICE=alloy
# Tope mensual del consumo interno del administrador (MXN).
ADMIN_MONTHLY_CAP_MXN=1000.00
# Recargas simuladas sin cobro real (el perfil dev las activa; en producción deben quedar en false).
SIMULATED_TOPUPS_ENABLED=false

# --- Fases siguientes (aún no se usan)
# PAYMENTS_GATEWAY=fake
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
# FX_PROVIDER=manual
# BANXICO_TOKEN=
